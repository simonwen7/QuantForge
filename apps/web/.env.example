# Server-only. The browser never receives this value.
# The Next.js route handler reads it when a request arrives.
# `next build` does not need it.
# `next dev` falls back to http://127.0.0.1:8000 when it is unset.
# A production process with this unset returns 503. It does not call localhost.
QUANTFORGE_API_ORIGIN=http://127.0.0.1:8000
